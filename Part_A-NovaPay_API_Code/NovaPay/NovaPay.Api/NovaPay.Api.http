@NovaPay.Api_HostAddress = http://localhost:5263
@token = novapay-dev-token

### Create wallet A
POST {{NovaPay.Api_HostAddress}}/wallets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerName": "Ada Lovelace"
}

### Create wallet B
POST {{NovaPay.Api_HostAddress}}/wallets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "ownerName": "Bola Ige"
}

### Credit wallet A (replace {{walletAId}})
POST {{NovaPay.Api_HostAddress}}/wallets/{{walletAId}}/credit
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amountKobo": 1000000
}

### Get wallet A balance
GET {{NovaPay.Api_HostAddress}}/wallets/{{walletAId}}
Authorization: Bearer {{token}}

### Transfer A -> B
POST {{NovaPay.Api_HostAddress}}/transfers
Authorization: Bearer {{token}}
Content-Type: application/json
Idempotency-Key: demo-key-1

{
  "fromWalletId": "{{walletAId}}",
  "toWalletId": "{{walletBId}}",
  "amountKobo": 200000
}
